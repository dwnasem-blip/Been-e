# Supabase Configuration
# These are PUBLIC keys - Safe to commit
# Get these from: Supabase Dashboard > Settings > API

# Supabase Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable Key (starts with sb_publishable_)
# Use this for frontend authentication
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ⚠️ SECURITY NOTES:
# - NEVER add these to the app:
#   * SUPABASE_SERVICE_ROLE_KEY
#   * SUPABASE_DB_PASSWORD
#   * JWT secrets
#   * Any private keys
#
# - Store actual values in:
#   * .env.local (local development - DO NOT COMMIT)
#   * Cloud Environment Variables (production)
#
# - All sensitive operations use Supabase Auth
# - No passwords stored in AsyncStorage
# - Session tokens managed by Supabase
